{
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "serena-agent==1.7.0",
        "serena",
        "start-mcp-server",
        "--context",
        "./contexts/codex-balanced.yml",
        "--enable-web-dashboard",
        "false",
        "--open-web-dashboard",
        "false"
      ],
      "cwd": "."
    },
    "semble": {
      "command": "uv",
      "args": [
        "run",
        "--python",
        "3.12",
        "--script",
        "./scripts/start_semble.py"
      ],
      "cwd": "."
    }
  }
}
