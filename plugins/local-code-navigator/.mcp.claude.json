{
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "serena-agent==1.7.0",
        "serena",
        "start-mcp-server",
        "--context",
        "${CLAUDE_PLUGIN_ROOT}/contexts/claude-balanced.yml",
        "--project",
        "${CLAUDE_PROJECT_DIR}",
        "--enable-web-dashboard",
        "false",
        "--open-web-dashboard",
        "false"
      ]
    },
    "semble": {
      "command": "uv",
      "args": [
        "run",
        "--python",
        "3.12",
        "--script",
        "${CLAUDE_PLUGIN_ROOT}/scripts/start_semble.py"
      ],
      "env": {
        "HF_HOME": "${CLAUDE_PLUGIN_DATA}/huggingface",
        "SEMBLE_CACHE_LOCATION": "${CLAUDE_PLUGIN_DATA}/semble-cache"
      }
    }
  }
}
